    {
      "parameters": {
        "jsCode": "const original = $('Workflow Input Trigger').first().json;\nconst raw = String(original.query ?? '').trim().toUpperCase();\nif (!raw) { throw new Error('No stock ticker was provided to GetChart'); }\nconst input = $input.first().json;\nlet ticker;\nif (raw.includes(':')) {\n  ticker = raw;\n} else {\n  const clean = (s) => String(s || '').replace(/<[^>]*>/g, '').toUpperCase();\n  const list = Array.isArray(input.symbols) ? input.symbols : [];\n  const usEx = ['NASDAQ', 'NYSE', 'AMEX', 'NYSEARCA', 'BATS', 'OTC'];\n  const hit = list.find((s) => clean(s.symbol) === raw && usEx.includes(String(s.exchange || '').toUpperCase())) || list.find((s) => clean(s.symbol) === raw) || list.find((s) => usEx.includes(String(s.exchange || '').toUpperCase()));\n  const ex = hit && hit.exchange ? String(hit.exchange).toUpperCase() : 'NASDAQ';\n  ticker = ex + ':' + raw;\n}\nreturn [{ json: { ticker } }];"
      },
